# Server port (default 3000)
PORT=3000
NODE_ENV=production

# Secret key for signing JWT authentication tokens (CHANGE THIS IN PRODUCTION!)
JWT_SECRET="change_this_to_a_long_random_production_secret"

# Optional comma-separated allowed CORS origins (leave empty to allow same-origin / default)
CORS_ORIGIN=""

# Persistent storage paths for production deployments (Docker volumes / VPS / Render Disk)
DB_PATH="./backend/data/eko_komissiya.db"
UPLOADS_DIR="./backend/uploads"

# Public URL of the deployed application
APP_URL="https://your-domain.example"
